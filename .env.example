# Copy to .env for local development (`npx netlify-cli dev` loads it), and set the same
# variables in Netlify > Site configuration > Environment variables for deploys.
# Never commit real values.

# Admin password hash. Generate with:  node scripts/hash-password.mjs --secret
# Format: scrypt:N:r:p:saltBase64:hashBase64
ADMIN_PASSWORD_HASH=scrypt:32768:8:1:REPLACE_WITH_SALT:REPLACE_WITH_HASH

# Random secret (>= 32 characters) used to sign admin session cookies.
# Changing it signs out every session.
ADMIN_SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING

# Web3Forms access key for the public contact form (exposed to the browser by design).
VITE_WEB3FORMS_ACCESS_KEY=REPLACE_WITH_YOUR_WEB3FORMS_KEY
